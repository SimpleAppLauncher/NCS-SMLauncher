# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Environments
.env
.env.*
!.env.example
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Secrets and credentials -- nothing personal or private should ever be
# committable. These patterns cover the common cases; anything that looks
# like a key, token, or password is excluded on principle.
*.env
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials*.json
*credentials*.txt
*secret*
*token*.txt
.secrets/
.private/
*.local.json
id_rsa*
*.ppk

# Local machine state that never belongs in a repo
.DS_Store
Thumbs.db
*.swp
*~

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created via remote AFP, SMB, FTP
.network_trash
.Temporary Items
.apdisk

# Linux
*~

# Temporary files created by text editors
*.swp
*.bak
*.tmp

# Logs
logs
*.log

# Torrent download folder (dynamic)
torrent-downloads/

# Android build outputs (optional, if you want to ignore them)
android/app/build/
android/.gradle/
android/.kotlin/

# Android machine-local SDK path — never commit this.
# Gradle/AGP generates it per machine; Android Studio or
# `echo "sdk.dir=$ANDROID_HOME" > android/local.properties` recreates it.
android/local.properties
# Local test scratch
tests/__pycache__/

# Ad-hoc manual copies of source files. Git history already keeps every
# version, so a .backup file in the tree is pure clutter -- three of these
# had been committed. Keep backups in git, not in filenames.
*.backup
*.backup_*
*.bak
*.orig
*.rej
.DS_Store
.screenshots/

# Compiled native core (build with scripts/build_native.sh; the .c source is
# committed, the library is a local artifact)
src/native/libncs_core.dylib
src/native/libncs_core.so
*.pyd
